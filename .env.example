# ==============================================================================
# Telegram Bot Webhook Service Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit real tokens or credentials to version control!
# ==============================================================================

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Secret token header for Telegram Webhook verification (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your_generated_random_secret_token_here

# Authorized Telegram user IDs (comma-separated numeric IDs)
ALLOWED_TELEGRAM_USER_IDS=12345678,87654321

# Allowed Telegram chat types (comma-separated: private, group, supergroup)
ALLOWED_CHAT_TYPES=private

# Fine-grained GitHub Personal Access Token (PAT) with Actions Read & Write permission
GITHUB_TOKEN=github_pat_11ABCDEFG...

# GitHub Repository Owner / Organization name
GITHUB_OWNER=your-github-username

# GitHub Repository Name
GITHUB_REPO=audio

# Workflow file name in .github/workflows/
GITHUB_WORKFLOW_FILE=transcribe.yml

# Target Git branch or reference for workflow dispatch
GITHUB_REF=main

# SQLite database file path for state tracking and idempotency
BOT_STATE_DB_PATH=data/telegram_bot.db

# Maximum direct download size in bytes for hosted Telegram Bot API (default 20 MB)
TELEGRAM_MAX_DIRECT_DOWNLOAD_BYTES=20971520

# Default transcription language (e.g. ar, en, fr, auto)
DEFAULT_LANGUAGE=ar

# Default faster-whisper model (tiny, base, small, medium, large-v3, turbo)
DEFAULT_MODEL=medium

# Default output formats (comma-separated: txt, srt, vtt, json)
DEFAULT_OUTPUT_FORMATS=txt

# Display GitHub Actions run URL in status updates (default false)
SHOW_GITHUB_RUN_URL=false

# Optional custom Telegram API base URL (for self-hosted Telegram Local Bot API Server)
TELEGRAM_API_BASE_URL=https://api.telegram.org
